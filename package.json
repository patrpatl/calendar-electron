{
  "name": "calendar",
  "version": "1.0.0",
  "description": "A calendar app.",
  "license": "ISC",
  "author": "patrpatl",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:smoke": "npm run build && node tests/run-smoke.js",
    "build": "node build-renderer.js",
    "build:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/build.ps1",
    "start": "node launcher.js",
    "start:electron": "node launcher.js --electron",
    "test:smoke:webview": "node tests/webview-smoke.js",
    "test:smoke:visible": "node tests/visible-launch.js"
  },
  "devDependencies": {
    "electron": "^45.1.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "vite": "^8.3.5"
  }
}
